# Copy to core/.env and fill in. Never commit the real .env.

# GitHub fine-grained token, only for Tradvia/tradvia:
# Contents: Read and write · Pull requests: Read and write · Issues: Read and write
GITHUB_TOKEN=
TRADVIA_REPO=Tradvia/tradvia
# Projects (repositories) the API accepts, comma separated. Default: TRADVIA_REPO.
TRADVIA_PROJECTS=Tradvia/tradvia

# Sign in with GitHub on the hosted panel (docs/github-app.md). Off unless all three are set.
# TRADVIA_DOMAIN is the panel's host name, e.g. app.tradvia.org.
TRADVIA_DOMAIN=
TRADVIA_GITHUB_APP_CLIENT_ID=
TRADVIA_GITHUB_APP_CLIENT_SECRET=
# python -c 'import secrets;print(secrets.token_urlsafe(32))'  (encrypts user tokens at rest)
TRADVIA_SECRET_KEY=

# Browser/phone notifications (Web Push, docs/notifications.md). Off unless both are set.
# Generate once: npx web-push generate-vapid-keys   (two base64url strings; more in the docs)
# The public key is sent to browsers; the private key stays only in this .env.
TRADVIA_VAPID_PUBLIC_KEY=
TRADVIA_VAPID_PRIVATE_KEY=
# Contact the push services may use (mailto: or https: URL). Default: https://$TRADVIA_DOMAIN
TRADVIA_VAPID_SUBJECT=

# Discord bot (Developer Portal → Bot → Reset Token) with "Message Content Intent" on
DISCORD_BOT_TOKEN=
# Right-click the channel → Copy Channel ID (Developer Mode on)
DISCORD_CHANNEL_ID=

# Planner model through LiteLLM, plus the provider key it needs
TRADVIA_PLANNER_MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=

# 1 = no LLM call; a fixed plan is used (good for a first dry run)
TRADVIA_OFFLINE=0
