{
	email {$ACME_EMAIL}
}

{$TRADVIA_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com; connect-src 'self' https://api.github.com; frame-ancestors 'none'"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /healthz {
		respond "ok" 200
	}

	redir / /runs/ 302

	handle_path /runs/* {
		root * /srv/dashboard
		file_server
	}
}
