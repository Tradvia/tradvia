# Build context: the directory that holds core/ (see compose.yaml).
FROM python:3.12-slim

RUN useradd --create-home --uid 10001 tradvia

WORKDIR /app
COPY core ./core
RUN pip install --no-cache-dir "./core[api]"

USER tradvia
EXPOSE 8000
CMD ["uvicorn", "tradvia.api:app", "--host", "0.0.0.0", "--port", "8000"]
